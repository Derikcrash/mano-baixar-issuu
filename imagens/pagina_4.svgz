="0 0 -0.14">patrimônio e incêndio.</text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 607.97 274.85)" dx="0 0 0 0 -0.13 -0.17 0 0.72 0 0 0.74 0 0 0 -0.13 -0.28 0 0.72 0 0.73 0 0 0 0.73 0 0 0 0 0 0 0 0.75 -0.22 0 0 0 0 0 0 -0.17">Diante do risco, o MPF decidiu requisitar </text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 588.70 289.81)" dx="0 0.30 0.30 0.29 2.11 0.30 2.11 0.30 0.30 0.30 0.29 0.29 0.30 0.16 0.12 0.29 0.30 0.30 0.29 0.30 0.29 0.30 0.30 2.11 0.30 0.30 2.11 -0.05 0.15 0.30 0.29 0.30 0.29 0.30 0.30 0.30 0.30 2.11 0.30">que a Superintendência do Patrimônio da </text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 588.70 304.77)" dx="0 0.20 0.21 0.21 0.21 0.21 2.02 0.21 0.21 0.20 0.20 0.21 2.02 0.21 0.21 2.02 -0.14 0.21 -0.13 0.21 2.01 0.21 0.12 -0.13 0.21 0.20 0.21 0.20 0.20 2.02 0.21 0.21 2.02 0.21 -0.13 0.21 -0.15 0.21 2.02 0.21 -0.01">União (SPU) no Pará informe, no prazo de </text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 588.70 319.73)" dx="0 -0.03 -0.03 -0.03 -0.17 -0.03 -0.93 -0.03 -0.03 -0.03 -0.03 -0.04 -0.94 -0.03 -0.03 -0.03 -0.03 -0.03 -0.93 -0.03 -0.04 -0.03 -0.03 -0.03 -0.03 -0.03 -0.93 -0.03 -0.03 -0.03 -0.23 -0.03 -0.37 -0.03 -0.94 -0.03 -0.03 -0.37 -0.03 -0.94 -0.17 -0.03 -0.17 -0.20 -0.03 -0.01">cinco dias, quais medidas adotará para conter </text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 588.70 334.69)" dx="0 0 0 1.08 0 0 0 0 0 -0.12 0 0 0 0 1.09 0 1.08 0 -0.22 -0.30 0 0 1.08 -0.20 0 0 0 0 0 1.07 0 -0.09 -0.17">as ocupações. O órgão também determinou </text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 588.70 349.65)" dx="0 0.38 0.38 0.38 2.19 0.37 0.38 0.20 0.22 0.38 0.37 0.38 0.38 2.19 0.21 0.37 0.38 0.38 0.38 0.24 0.38 2.19 0.38 0.16 0.37 0.38 0.37 0.38 0.38 0.38 0.38 0.38 2.19 0.37 2.19 0.38 0.16 0.24 0.37 0.24 0.21 -0.01">uma vistoria técnica presencial e urgente </text><text class="ff6 fc1" transform="matrix(0.85 0 0 0.85 588.70 364.61)" dx="0 0.03 0.03 -0.30 0.03 1.84 0.04 