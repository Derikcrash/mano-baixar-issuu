<svg viewBox="0 0 1156 1600" version="1.1" preserveAspectRatio="xMinYMin meet" text-rendering="geometricPrecision" class="p19" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><defs><style type="text/css">text{white-space:pre;font-size:16px;font-weight:normal;font-style:normal;fill:none;unicode-bidi:bidi-override}@font-face{font-family:"p19_g_d0_f1";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f2";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f4";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f12";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f13";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f14";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f15";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f19";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f20";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}@font-face{font-family:"p19_g_d0_f21";src:url("data:application/font-woff;charset=utf-8;base64,") format("woff");}.p19 .ff1{font-family:"p19_g_d0_f1",sans-serif;line-height:1}.p19 .ff2{font-family:"p19_g_d0_f2",sans-serif;line-height:1}.p19 .ff3{font-family:"p19_g_d0_f4",serif;line-height:1}.p19 .ff4{font-family:"p19_g_d0_f20",sans-serif;line-height:1}.p19 .ff5{font-family:"p19_g_d0_f15",sans-serif;line-height:1}.p19 .ff6{font-family:"p19_g_d0_f12",sans-serif;line-height:1}.p19 .ff7{font-family:"p19_g_d0_f14",sans-serif;line-height:1}.p19 .ff8{font-family:"p19_g_d0_f13",sans-serif;line-height:1}.p19 .ff9{font-family:"p19_g_d0